{
  "name": "eddie-sun",
  "displayName": "Eddie Sun",
  "description": "Highlights code based on Commit Hashes",
  "version": "0.1.0",
  "publisher": "x-blom",
  "engines": {
    "vscode": "^1.100.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/x-blom/Eddie-Sun.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commit-hash-highlighter.openSidebar",
        "title": "Open Commit Hash Highlighter",
        "category": "Commit Hash Highlighter",
        "icon": "$(heart)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commit-hash-highlighter-activitybar",
          "title": "Commit Hash Highlighter",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "commit-hash-highlighter-activitybar": [
        {
          "id": "commit-hash-highlighter-sidebar",
          "name": "Commit Hashes",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.39.5",
    "mocha": "^12.0.3",
    "typescript": "~5.9"
  }
}
